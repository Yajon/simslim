class Simslim < Formula
  desc "Run more iOS, tvOS, watchOS, and visionOS simulators on one Mac by disabling unneeded background daemons"
  homepage "https://github.com/mobai-app/simslim"
  url "@SOURCE_URL@"
  sha256 "@SOURCE_SHA256@"
  license "MIT"

  depends_on "go" => :build
  depends_on arch: :arm64
  depends_on :macos

  def install
    # std_go_args passes no package path, so the CLI must be named explicitly:
    # the repo root is the importable simslim library, not package main.
    system "go", "build", *std_go_args(ldflags: "-X main.version=#{version}"), "./cmd/simslim"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/simslim --version")

    # popen_read_text force-encodes command output to Encoding.default_external
    # (US-ASCII on some runners), which breaks assert_match against a UTF-8
    # string. Match the Chinese bytes inside the shell and assert on an ASCII
    # marker instead. This also covers the help text, the translation table,
    # the English fallback, and the language-independent --json output.
    assert_match "localization OK", shell_output(<<~SH)
      cli="#{bin}/simslim"
      SIMSLIM_LANG=zh-Hans "$cli" --help | /usr/bin/grep -F '用法' >/dev/null || exit 1
      SIMSLIM_LANG=zh-Hans "$cli" profiles | /usr/bin/grep -F '小组件与壁纸' >/dev/null || exit 1
      SIMSLIM_LANG=en "$cli" --help | /usr/bin/grep -F 'USAGE' >/dev/null || exit 1
      test "$(SIMSLIM_LANG=en "$cli" profiles --json)" = "$(SIMSLIM_LANG=zh-Hans "$cli" profiles --json)" || exit 1
      echo "localization OK"
    SH
  end
end
